{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "cheering react (vite/spa)",
  "extends": "@cheering/typescript-config/base",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],

    "noEmit": true
  }
}