{
  "name": "@cheering/ui",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./styles": "./dist/index.css"
  },
  "scripts": {
    "build": "tailwindcss -i ./src/index.css -o ./dist/index.css",
    "dev": "tailwindcss -i ./src/index.css -o ./dist/index.css --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@cheering/eslint-config": "workspace:*",
    "@cheering/tailwind-config": "workspace:*",
    "@cheering/typescript-config": "workspace:*",
    "@fortawesome/fontawesome-svg-core": "^7.0.0",
    "@fortawesome/free-brands-svg-icons": "^7.0.0",
    "@fortawesome/free-regular-svg-icons": "^7.0.0",
    "@fortawesome/free-solid-svg-icons": "^7.0.0",
    "@fortawesome/react-fontawesome": "^3.0.1",
    "@tailwindcss/cli": "^4.1.12",
    "@types/node": "^22.15.3",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.1",
    "clsx": "^2.1.1",
    "eslint": "^9.34.0",
    "tailwindcss": "^4.1.12",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-aria": "^3.43.1",
    "react-dom": "^19.1.0",
    "react-stately": "^3.41.0"
  }
}
