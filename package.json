{
  "name": "cheering-rocket",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "cap:sync": "pnpm -C apps/app exec cap sync",
    "cap:run:android": "pnpm -C apps/app exec cap run android",
    "cap:copy": "pnpm -C apps/app exec cap copy",
    "fb:emulators": "pnpm -C apps/firebase -r run build && pnpm -C apps/firebase exec firebase emulators:start",
    "fb:deploy:rules": "pnpm -C apps/firebase exec firebase deploy --only firestore:rules,storage",
    "fb:deploy": "pnpm -C apps/firebase/functions run deploy"
  },
  "devDependencies": {
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.34.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "5.9.2",
    "vitest": "^4.1.0",
    "lefthook": "^1.13.4"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.15.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
