# Firebase Web クライアント設定
VITE_FIREBASE_API_KEY=...
VITE_FIREBASE_AUTH_DOMAIN=...
VITE_FIREBASE_PROJECT_ID=...
VITE_FIREBASE_APP_ID=...
VITE_FIREBASE_SENDER_ID=...

# Google Maps JavaScript API キー
VITE_GOOGLE_MAPS_API_KEY=...

# Cloud Functions 呼び出し向け設定
# デフォルトは asia-northeast1。別リージョンを使う場合に上書き
VITE_FIREBASE_FUNCTIONS_REGION=asia-northeast1
# エミュレーターを利用する場合に http://localhost:5001 のように指定
VITE_FIREBASE_FUNCTIONS_EMULATOR_ORIGIN=http://localhost:5001

# 応援ページの動作調整
# ポーリング間隔 (ミリ秒)
VITE_CHEER_POLLING_INTERVAL_MS=15000
# 走行履歴として保持する最大ポイント数
VITE_CHEER_HISTORICAL_POINTS_WINDOW=50
# 公開用の応援ページ URL（アプリから配布するリンクに利用）
VITE_CHEER_WEB_BASE_URL=https://cheering-web.example.com
