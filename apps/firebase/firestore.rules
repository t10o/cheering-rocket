rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // 自分のユーザー文書のみ R/W 可
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 例：公開読み取りが必要なコレクションがあれば個別に許可
    // match /public/{doc} {
    //   allow read: if true;
    //   allow write: if request.auth != null && request.auth.token.admin == true;
    // }
  }
}